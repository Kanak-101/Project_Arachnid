# System-wide systemd service for Project Arachnid (Quadbot)
# Installation:
#   sudo cp deploy/quadbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now quadbot
#
# Note: Because this service points directly to run_server.py, all code changes
# take effect immediately upon server restart without rebuilding any packages.

[Unit]
Description=Project Arachnid (Quadbot) Server & Control Loop
After=network.target

[Service]
Type=simple
User=tron
WorkingDirectory=/mnt/Kanak/Project Arachnid/quadbot
ExecStart=/mnt/Kanak/Project Arachnid/quadbot/.venv/bin/python /mnt/Kanak/Project Arachnid/quadbot/run_server.py --config config/robot.yaml --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
