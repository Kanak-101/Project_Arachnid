# sudo cp deploy/quadbot.service /etc/systemd/system/ && sudo systemctl enable --now quadbot
# Edit User and the paths to match your Pi.
[Unit]
Description=quadbot dashboard and control loop
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/quadbot
ExecStart=/home/pi/quadbot/.venv/bin/python -m quadbot.server --config config/robot.yaml --host 0.0.0.0 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
