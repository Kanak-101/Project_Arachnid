[Unit]
Description=Project Arachnid Robot Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/arachnid
ExecStart=/usr/bin/python3 /home/pi/arachnid/arachnid_server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
